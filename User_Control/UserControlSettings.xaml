<UserControl x:Class="Hotel_Managment_System.User_Control.UserControlSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hotel_Managment_System.User_Control"
             mc:Ignorable="d" Height="542" Width="918">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF191717" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <TabControl Margin="64,68,66,40" TabStripPlacement="Bottom" BorderBrush="Black">
            <TabControl.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF191717" Offset="1"/>
                </LinearGradientBrush>
            </TabControl.Background>
            <TabItem Header="Add User" BorderBrush="{x:Null}" FontWeight="Bold" FontFamily="Yu Gothic UI">
                <Grid Margin="0,0,0,2">
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="#FF191717" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Label Content="First Name :" HorizontalAlignment="Left" Margin="198,65,0,310" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"/>
                    <Label Content="Last Name :" HorizontalAlignment="Left" Margin="426,70,0,305" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"/>
                    <TextBox x:Name="Firstname" HorizontalAlignment="Left" Margin="198,99,0,280" TextWrapping="NoWrap" Width="193" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" PreviewTextInput="Username_OnlyValid" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" />
                    <Button
                        Content="Add User"
                        Height="34"
                        FontFamily="Yu Gothic UI"
                        FontWeight="Bold"
                        FontSize="14"
                        Foreground="White"
                        BorderThickness="0"
                        Focusable="False"
                        OverridesDefaultStyle="True" Margin="200,343,434,27"
                        Cursor="Hand" Click="Button_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">

                                <Border x:Name="border"
                                    CornerRadius="6"
                                    Background="#FF25C6DC"
                                    RenderTransformOrigin="0.5,0.5">

                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>

                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>

                                    <!-- HOVER ENTER -->
                                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                    To="1.04"
                                                    Duration="0:0:0.15"/>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                    To="1.04"
                                                    Duration="0:0:0.15"/>
                                                <ColorAnimation
                                                    Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FF3ED8EE"
                                                    Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <!-- HOVER LEAVE -->
                                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                    To="1"
                                                    Duration="0:0:0.15"/>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                    To="1"
                                                    Duration="0:0:0.15"/>
                                                <ColorAnimation
                                                    Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FF25C6DC"
                                                    Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <!-- PRESSED -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                        To="0.96"
                                                        Duration="0:0:0.06"/>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                        To="0.96"
                                                        Duration="0:0:0.06"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>

                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBox x:Name="lastname" HorizontalAlignment="Left" Margin="426,99,0,278" TextWrapping="NoWrap" Width="193" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" RenderTransformOrigin="0.5,0.5" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden">
                        <TextBox.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0.248"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </TextBox.RenderTransform>
                    </TextBox>
                    <Label Content="Add User : " HorizontalAlignment="Left" Margin="10,10,0,364" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" Width="90" FontSize="16"/>
                    <TextBox x:Name="jobdes" HorizontalAlignment="Left" Margin="198,161,0,219" TextWrapping="NoWrap" Width="421" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    <Label Content="Job Postion: " HorizontalAlignment="Left" Margin="198,129,0,246" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"/>
                    <TextBox x:Name="username" HorizontalAlignment="Left" Margin="198,224,0,156" TextWrapping="NoWrap" Width="193" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" PreviewTextInput="Username_OnlyValid" PreviewKeyDown="Username_BlockSpace" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    <TextBox x:Name="password" HorizontalAlignment="Left" Margin="426,224,0,156" TextWrapping="NoWrap" Width="193" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    <Label Content="Username :" HorizontalAlignment="Left" Margin="200,190,0,185" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"/>
                    <Label Content="Password :" HorizontalAlignment="Left" Margin="429,188,0,187" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"/>
                    <TextBox x:Name="email" HorizontalAlignment="Left" Margin="198,289,0,91" TextWrapping="NoWrap" Width="210" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    <TextBox x:Name="phone" HorizontalAlignment="Left" Margin="426,289,0,91" TextWrapping="NoWrap" Width="193" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" PreviewTextInput="Phone_OnlyNumbers" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    <Label Content="Email :" HorizontalAlignment="Left" Margin="200,260,0,115" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"/>
                    <Label Content="Phone:" HorizontalAlignment="Left" Margin="429,260,0,115" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="Enter" Header="Manage Users" BorderBrush="{x:Null}" FontWeight="Bold" FontFamily="Yu Gothic UI">
                <Grid>
                    <TextBox x:Name="Usernamesh" HorizontalAlignment="Left" Margin="34,85,0,297" TextWrapping="NoWrap" Width="192" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" TextChanged="Usernamesh_TextChanged" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    <Label Content="Search Users :" HorizontalAlignment="Left" Margin="10,10,0,367" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"/>
                    <Label Content="Username :" HorizontalAlignment="Left" Margin="34,52,0,325" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" Width="96" FontSize="16"/>
                    <TextBox x:Name="emailsh" HorizontalAlignment="Left" Margin="256,86,0,296" TextWrapping="NoWrap" Width="208" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" TextChanged="emailsh_TextChanged" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    <Label Content="Email :" HorizontalAlignment="Left" Margin="256,52,0,325" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" Width="78" FontSize="16"/>
                    <TextBox x:Name="phonesh" HorizontalAlignment="Left" Margin="493,85,0,297" TextWrapping="NoWrap" Width="192" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" TextChanged="phonesh_TextChanged" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    <Label Content="Phone :" HorizontalAlignment="Left" Margin="493,56,0,321" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" Width="78" FontSize="16"/>
                    <TextBox x:Name="firstnamesh" HorizontalAlignment="Left" Margin="34,149,0,233" TextWrapping="NoWrap" Width="192" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" TextChanged="firstnamesh_TextChanged" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    <Label Content="First Name :" HorizontalAlignment="Left" Margin="34,115,0,262" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" Width="96" FontSize="16"/>
                    <TextBox x:Name="lastnamesh" HorizontalAlignment="Left" Margin="264,149,0,233" TextWrapping="NoWrap" Width="192" BorderBrush="{x:Null}" SelectionBrush="#FF25439E" FontSize="14" SelectionTextBrush="{x:Null}" TextChanged="lastnamesh_TextChanged" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    <Label Content="Last Name:" HorizontalAlignment="Left" Margin="264,115,0,262" Height="29" Foreground="White" FontFamily="Yu Gothic UI" FontWeight="Bold" Width="90" FontSize="16"/>
                    <DataGrid x:Name="UsersGrid"
          Margin="0,190,0,0"
          Foreground="#FF191717"
          Background="White"
          HeadersVisibility="Column"
          HorizontalGridLinesBrush="Black"
          VerticalGridLinesBrush="Black"
          MinColumnWidth="110"
          RowEditEnding="UsersGrid_RowEditEnding"
          IsReadOnly="False"
          AutoGenerateColumns="False"
          CanUserAddRows="False">

                        <DataGrid.Columns>

                            <!-- ID (غير قابل للتعديل) -->
                            <DataGridTextColumn Header="ID"
                            Binding="{Binding ID}"
                            IsReadOnly="True"/>

                            <!-- Editable columns -->
                            <DataGridTextColumn Header="Username"
            Binding="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <DataGridTextColumn Header="Email"
            Binding="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <DataGridTextColumn Header="Phone"
            Binding="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Job"
Binding="{Binding Job, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="First Name"
Binding="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Last Name"
Binding="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Password"
Binding="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Delete Button -->
                            <DataGridTemplateColumn >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                            Width="20"
                            Click="DeleteUser_Click" Height="20" BorderBrush="White" Foreground="White" Cursor="Hand">
                                            <Button.Background>
                                                <ImageBrush ImageSource="/User_Control/supprimer.png"/>
                                            </Button.Background>
                                            <Button.Style>

                                                <Style TargetType="{x:Type Button}">


                                                    <Setter Property="Background" Value="LightGray"/>
                                                    <Setter Property="BorderBrush" Value="DarkGray"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type Button}">
                                                                <Border Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
    VerticalAlignment="Top"
         />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>


            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
